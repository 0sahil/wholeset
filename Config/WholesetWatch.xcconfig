// watchOS app target (single-target SwiftUI app, embedded in the iOS app).
// Inherits project settings from Base.xcconfig.

SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
WATCHOS_DEPLOYMENT_TARGET = 26.0

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = app.wholeset.watchkitapp
CODE_SIGN_ENTITLEMENTS = WholesetWatch/WholesetWatch.entitlements
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_PREVIEWS = YES
SKIP_INSTALL = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Info.plist: generated from the keys below, merged with WholesetWatch/Info.plist,
// which holds the array-valued keys that have no INFOPLIST_KEY_ setting.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = WholesetWatch/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Wholeset
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = app.wholeset
INFOPLIST_KEY_WKRunsIndependentlyOfCompanionApp = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_NSHealthShareUsageDescription = Wholeset reads your heart rate and active energy during workouts to show them live and in your workout summary.
INFOPLIST_KEY_NSHealthUpdateUsageDescription = Wholeset saves your strength workouts to Apple Health, including heart rate and active energy, so they appear in Fitness and count toward your Activity rings.
